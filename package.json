{
  "name": "alexandrine-oxiana",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "review-pages": "node scripts/build-review-pages.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --passWithNoTests --reporter=default --reporter=json --outputFile.json=reports/vitest.json",
    "test:scale": "vitest run --config packages/library/vitest.scale.config.ts && vitest run --config packages/library/vitest.zotero-scale.config.ts",
    "test:scripts": "node --test scripts/test-report.test.mjs scripts/e2e-args.test.mjs scripts/build-sidecars.test.mjs scripts/notices/licence-texts.test.mjs scripts/licence.test.mjs scripts/test-nonroot.test.mjs apps/browser-extension/scripts/package.test.mjs",
    "test:nonroot": "node scripts/test-nonroot.mjs",
    "test:py": "node scripts/run-pytest.mjs",
    "e2e": "node scripts/run-e2e.mjs",
    "report": "node scripts/test-report.mjs",
    "setup:py": "node scripts/setup-py.mjs",
    "fetch-fixtures": "node scripts/fetch-fixtures.mjs",
    "fetch-csl": "node scripts/fetch-csl.mjs",
    "ao": "tsx apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
