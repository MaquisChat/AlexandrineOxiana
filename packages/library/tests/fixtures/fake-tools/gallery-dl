#!/usr/bin/env node
// Fake gallery-dl for tests (no network). Behaviour from FAKE_TOOL_MODE: ok (default), login, partial,
// notfound. Writes one image plus one metadata JSON (gallery-dl --write-metadata) per item of the
// matching fixture (see below).
// FAKE_ARGV_FILE (optional) receives the arguments as JSON.
import { mkdirSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const args = process.argv.slice(2);
if (args.includes("--version")) {
  console.log("1.30.10");
  process.exit(0);
}
if (process.env.FAKE_ARGV_FILE) writeFileSync(process.env.FAKE_ARGV_FILE, JSON.stringify(args));
const out = args[args.indexOf("-D") + 1];
mkdirSync(out, { recursive: true });
const url = args[args.length - 1];
const mode = process.env.FAKE_TOOL_MODE || "ok";
const fixtures = join(dirname(fileURLToPath(import.meta.url)), "..", "capture");

if (mode === "login") {
  console.error("[instagram][error] HttpError: 'Redirect to login page' - login required");
  console.error("ERROR: login required");
  process.exit(4);
}
if (mode === "notfound") {
  console.error("[instagram][error] NotFoundError: Requested post could not be found (404)");
  process.exit(4);
}
// A synthetic Instagram profile (FAKE_PROFILE_FILE with platform "instagram"): the profile link
// writes one metadata JSON per post (with --no-download no images), a /p/<code>/ link one post.
if (process.env.FAKE_PROFILE_FILE) {
  const prof = JSON.parse(readFileSync(process.env.FAKE_PROFILE_FILE, "utf8"));
  if (prof.platform === "instagram") profileRun(prof);
}

function profileRun(prof) {
  const user = {
    username: prof.handle, full_name: prof.displayName, biography: prof.bio, external_url: (prof.links ?? [])[0],
    follower_count: prof.followers, following_count: prof.following, media_count: prof.items.filter((it) => (it.listing ?? "posts") === "posts").length,
    profile_pic_url: prof.avatar, is_verified: prof.verified ?? false,
  };
  const date = (ts) => new Date(ts * 1000).toISOString().slice(0, 19).replace("T", " ");
  const meta = (it) => ({
    category: "instagram", subcategory: "post", post_shortcode: it.id, shortcode: it.id, post_id: `3${it.id.length}000`, description: it.caption,
    username: prof.handle, fullname: prof.displayName, owner_id: "9990001", post_date: date(it.timestamp), date: date(it.timestamp),
    post_url: `https://www.instagram.com/p/${it.id}/`, display_url: "https://scontent.example/x.jpg?_nc_ht=SECRET&oh=1&oe=2", user,
  });
  const code = /\/p\/([\w-]+)/.exec(url)?.[1];
  if (code) {
    const pos = prof.items.findIndex((it) => it.id === code);
    if (pos < 0) return;
    if (mode === "ratelimit" && pos >= (prof.rateLimitAfter ?? 3)) {
      console.error("[instagram][error] HttpError: '429 Too Many Requests'");
      process.exit(4);
    }
    const it = prof.items[pos];
    if (!args.includes("--no-download")) writeFileSync(join(out, `${it.id}_1.jpg`), Buffer.from(`\xff\xd8\xff\xe0 fake jpeg ${it.id}`, "latin1"));
    writeFileSync(join(out, `${it.id}_1.jpg.json`), JSON.stringify({ ...meta(it), num: 1 }));
    process.exit(0);
  }
  if (!url.includes(`instagram.com/${prof.handle}/`)) return;
  // `listing`: posts (default) or reels (`/<handle>/reels/`); `count`: images of a carousel. Like
  // gallery-dl, --range counts files, not posts.
  const listing = /\/reels\/?$/.test(url) ? "reels" : "posts";
  let items = prof.items.filter((it) => (it.listing ?? "posts") === listing);
  if (mode === "enumpartial") items = items.slice(0, prof.cutAfter ?? 7);
  let files = items.flatMap((it) => Array.from({ length: it.count ?? 1 }, (_, i) => [it, i + 1]));
  const range = args.indexOf("--range");
  if (range >= 0) files = files.slice(0, Number(args[range + 1].split("-")[1]));
  for (const [it, n] of files) writeFileSync(join(out, `${it.id}_${n}.jpg.json`), JSON.stringify({ ...meta(it), num: n }));
  if (mode === "enumpartial" || mode === "enumratelimit") {
    console.error("[instagram][error] HttpError: '429 Too Many Requests'");
    process.exit(4);
  }
  process.exit(0);
}

// gallery-dl fixtures: every capture/*.json except yt-dlp's *.info.json; the one whose
// post_shortcode (Instagram) or id (TikTok) is in the URL.
let post;
for (const f of readdirSync(fixtures).filter((n) => n.endsWith(".json") && !n.endsWith(".info.json"))) {
  const j = JSON.parse(readFileSync(join(fixtures, f), "utf8"));
  const key = j.post_shortcode ?? j.id;
  if (key && url.includes(String(key))) post = j;
}
if (!post) {
  console.error("[gallery-dl][error] No suitable extractor found");
  process.exit(64);
}
const key = post.post_shortcode ?? post.id;
const total = post.count ?? 1;
const n = mode === "partial" ? 1 : total;
for (let i = 1; i <= n; i++) {
  const name = `${key}_${i}.jpg`;
  writeFileSync(join(out, name), Buffer.from(`\xff\xd8\xff\xe0 fake jpeg ${i}`, "latin1"));
  const extra = post.post_shortcode ? { shortcode: `${key}x${i}` } : {};
  writeFileSync(join(out, `${name}.json`), JSON.stringify({ ...post, ...extra, num: i, filename: `${key}_${i}` }));
  console.log(join(out, name));
}
if (mode === "partial") {
  console.error("[instagram][error] HttpError: '429 Too Many Requests'");
  process.exit(4);
}
process.exit(0);
