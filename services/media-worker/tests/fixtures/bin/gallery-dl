#!/usr/bin/env python3
"""Fake gallery-dl for tests: writes one image and its metadata JSON into -D <dir>."""
import json, os, sys
from pathlib import Path

args = sys.argv[1:]
if "--version" in args:
    print("1.32.19")
    sys.exit(0)
if os.environ.get("FAKE_ARGV_FILE"):
    Path(os.environ["FAKE_ARGV_FILE"]).write_text(json.dumps(args))
out = Path(args[args.index("-D") + 1])
out.mkdir(parents=True, exist_ok=True)
(out / "post_1.jpg").write_bytes(b"\xff\xd8\xff\xe0fakejpeg")
(out / "post_1.jpg.json").write_text(json.dumps({"post_id": "1"}))
sys.exit(0)
