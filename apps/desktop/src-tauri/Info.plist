<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged by the Tauri bundler into the Mac app's Info.plist (tauri-cli reads src-tauri/Info.plist on macOS).

  NSAllowsLocalNetworking: the page calls the library service over plain http on 127.0.0.1. Apple's
  documentation of this key: "In iOS 17, iPadOS 17, and macOS 14, ATS no longer allows connections to IP
  addresses by default"; the key enables "access to unqualified domains, .local domains, and IP addresses"
  without turning App Transport Security off for anything else
  (https://developer.apple.com/documentation/bundleresources/information-property-list/nsapptransportsecurity/nsallowslocalnetworking,
  read 2026-11-12). It widens nothing beyond local addresses; the global exception for arbitrary loads is not used.
  The content-security policy still limits the page to http://127.0.0.1:* and http://localhost:*.

  NSFileProviderDomainUsageDescription: Apple lists it under protected resources as "A message that tells people
  why the app needs access to files managed by a file provider" (Google Drive, OneDrive and Dropbox keep their
  folders under ~/Library/CloudStorage as File Provider domains)
  (https://developer.apple.com/documentation/bundleresources/protected-resources,
  read 2026-11-13). macOS shows the text when the app first reads a cloud-drive folder the researcher chose to watch.
-->
<plist version="1.0">
<dict>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
  <key>NSFileProviderDomainUsageDescription</key>
  <string>Alexandrine Oxiana reads the files in the cloud-drive folders you choose to watch, to copy them into your library. It never changes, moves or deletes them.</string>
</dict>
</plist>
