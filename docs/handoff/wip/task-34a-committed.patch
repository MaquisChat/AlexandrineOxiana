+    const done = new Promise<number>((resolve) => {
+      const req = httpRequest({ host: "127.0.0.1", port, path, method: "GET", headers: { host: `127.0.0.1:${port}` } }, (res) => {
+        res.on("data", (d: Buffer) => {
+          got += d.length;
